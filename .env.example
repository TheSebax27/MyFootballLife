# Copia este archivo a .env.local y rellena los valores.
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable). Es seguro exponerla porque RLS protege los datos.
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ⚠️ NUNCA añadas SUPABASE_SERVICE_ROLE_KEY aquí ni en las variables de Vercel.
# Solo vive como secret de las Edge Functions (supabase secrets set ...).
